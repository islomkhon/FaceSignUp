{
  "name": "facesignup-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": ".venv\\Scripts\\python.exe -m uvicorn backend.app:app --host 127.0.0.1 --port 8100 --reload",
    "start": ".venv\\Scripts\\python.exe -m uvicorn backend.app:app --host 127.0.0.1 --port 8100",
    "build": "vite build",
    "preview": "vite preview",
    "localize:mediapipe": "node scripts/localize-mediapipe.mjs",
    "test": ".venv\\Scripts\\python.exe -m pytest -q",
    "check:locales": "node scripts/check_locales.mjs",
    "check:production": ".venv\\Scripts\\python.exe scripts\\check_production.py",
    "postinstall": "node scripts/localize-mediapipe.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "vite": "^8.3.8"
  }
}
